table profile_report
	lineageTag: d606edbe-0637-4374-96b2-238dd946a21f
	sourceLineageTag: [dbo].[profile_report]

	measure 'nulls total' = SUM(profile_report[nulls])
		formatString: 0
		lineageTag: b0d570cf-fce0-49d3-becc-eeef2b780cfc

		changedProperty = Name

	measure 'row count' = MAX(profile_report[row_count])
		formatString: 0
		lineageTag: 0ee85a0a-9912-4bf0-ba4a-32529c7b2806

		changedProperty = Name

	measure 'null %' =
			
			DIVIDE(
			    [nulls total],
			    [Row Count],
			    0
			)
		lineageTag: bbdd9ba7-d9dd-45b6-bfe3-8b34c8904482

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'DQ Score Simple' = 1 - [null %]
		lineageTag: be819bc2-8409-4fd7-a31a-d84f9f6758b3

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '# Columns' = ```
			DISTINCTCOUNT(profile_report[column_name])
			
			```
		formatString: 0
		lineageTag: 4cae998e-af0b-4314-b1b0-6986ff7fac81

		changedProperty = Name

	measure '# Tables' = ```
			DISTINCTCOUNT(profile_report[table_name])
			
			```
		formatString: 0
		lineageTag: e788eac9-bae7-408e-bf0c-72e783649ca7

		changedProperty = Name

	measure 'Columns with High Nulls' =
			CALCULATE(
			    [# Columns],
			    FILTER(
			        VALUES(profile_report[column_name]),
			        [Null %] > 0.2   -- 20 %, uprav podľa seba
			    )
			)
		formatString: 0
		lineageTag: b4acae19-8256-436c-b29c-0cd8a907c5c8

		changedProperty = Name

